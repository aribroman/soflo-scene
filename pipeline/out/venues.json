[{"title": "Vizcaya Village Farmers Market", "dates": ["2026-11-29", "2026-12-06", "2026-12-13"], "start": null, "end": null, "venue": "Vizcaya Museum & Gardens", "address": "3251 S Miami Ave, Miami, FL 33129", "city": "Miami", "county": "Miami-Dade", "zip": "33129", "lat": 25.7443, "lng": -80.2104, "category": "Markets", "free": true, "price_min": null, "price_max": null, "price_text": "Free", "desc": "Taste the artistry of local vendors as you explore Vizcaya\u2019s historic farm and village. Discover fresh delicacies, hand-crafted goods, fruits and vegetables, baked goods, vegan products, and more.", "url": "https://www.eventbrite.com/e/free-vizcaya-village-farmers-market-tickets-536305954547?aff=web&occurrence=2026-11-29", "source": "eventbrite.com", "tags": ["free", "outdoor"]}, {"title": "$5 Yoga | Sunday Wellness Classes", "dates": ["2026-11-29", "2026-12-06", "2026-12-13"], "start": null, "end": null, "venue": "Vizcaya Museum & Gardens", "address": "3251 S Miami Ave, Miami, FL 33129", "city": "Miami", "county": "Miami-Dade", "zip": "33129", "lat": 25.7443, "lng": -80.2104, "category": "Sports & Fitness", "free": false, "price_min": 5.0, "price_max": 5.0, "price_text": "$5", "desc": "Check out the $5 wellness classes at the Vizcaya Village Farmers Market. The first three Sundays of the month feature an all-level outdoor yoga class. The final class rotates monthly to add variety; classes will range from Tai Chi and Zumba to sound bowl meditation and other options. FREE for\u2026", "url": "https://www.eventbrite.com/e/5-sunday-yoga-at-the-vizcaya-village-farmers-market-tickets-738838213987?aff=web&occurrence=2026-11-29", "source": "eventbrite.com", "tags": []}, {"title": "Guided Tours of Historic Vizcaya Village", "dates": ["2026-11-29", "2026-12-06", "2026-12-13"], "start": null, "end": null, "venue": "Vizcaya Museum & Gardens", "address": "3251 S Miami Ave, Miami, FL 33129", "city": "Miami", "county": "Miami-Dade", "zip": "33129", "lat": 25.7443, "lng": -80.2104, "category": "Arts & Culture", "free": false, "price_min": 6.0, "price_max": 6.0, "price_text": "$6", "desc": "Did you know Vizcaya has a historic village just across the street from the Main House and gardens? Explore its fascinating history with $6 guided tours every Sunday at 11:00 a.m.\u2014reserve your spot online today!", "url": "https://www.eventbrite.com/e/vizcaya-village-guided-tour-tickets-435718264057?aff=web&occurrence=2026-11-29", "source": "eventbrite.com", "tags": []}, {"title": "Vizcaya\u2019s Marine Garden: A Behind the Scenes Guided Tour", "dates": ["2026-12-04"], "start": null, "end": null, "venue": "Vizcaya Museum & Gardens", "address": "3251 S Miami Ave, Miami, FL 33129", "city": "Miami", "county": "Miami-Dade", "zip": "33129", "lat": 25.7443, "lng": -80.2104, "category": "Outdoors & Nature", "free": false, "price_min": 39.0, "price_max": 39.0, "price_text": "$39", "desc": "The peacock statues by master sculptor Gaston Lachaise have returned to the Marine Garden for the first time in more than 30 years! Celebrate this momentous occasion with the exclusive opportunity to go behind the scenes and explore this magical garden room with Vizcaya's Lead Conservator, Davina\u2026", "url": "https://www.eventbrite.com/e/vizcayas-marine-garden-a-behind-the-scenes-guided-tour-tickets-2003682597587?aff=web&occurrence=2026-12-04", "source": "eventbrite.com", "tags": ["outdoor"]}, {"title": "Vizcaya Late | Holiday Evening", "dates": ["2026-12-09"], "start": null, "end": null, "venue": "Vizcaya Museum & Gardens", "address": "3251 S Miami Ave, Miami, FL 33129", "city": "Miami", "county": "Miami-Dade", "zip": "33129", "lat": 25.7443, "lng": -80.2104, "category": "Arts & Culture", "free": false, "price_min": 15.0, "price_max": 15.0, "price_text": "$15", "desc": "Make a holiday lantern, hear Vocal Youth Miami perform seasonal music from around the world, and see the Main House decorated as it was a century ago. Sip complimentary hot chocolate and stroll the ill